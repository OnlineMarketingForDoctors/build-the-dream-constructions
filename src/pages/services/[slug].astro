---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { servicePages } from '../../data/servicePages.js';
import { business } from '../../data/site.js';

// Heroes
import heroKitchen from '../../assets/svc/hero-kitchen.webp';
import heroBathroom from '../../assets/svc/hero-bathroom.webp';
import heroDecking from '../../assets/svc/hero-decking.webp';
import heroFlooring from '../../assets/svc/hero-flooring.webp';
import heroTiling from '../../assets/svc/hero-tiling.webp';
import heroGranny from '../../assets/svc/hero-granny.webp';

// Full bleed bands
import bandKitchen from '../../assets/svc/band-kitchen.webp';
import bandBathroom from '../../assets/svc/band-bathroom.webp';
import bandDecking from '../../assets/svc/band-decking.webp';
import bandFlooring from '../../assets/svc/band-flooring.webp';
import bandTiling from '../../assets/svc/band-tiling.webp';
import bandGranny from '../../assets/svc/band-granny.webp';

// Inclusion blocks, four per service
import k1 from '../../assets/svc/kitchen-1.webp';
import k2 from '../../assets/svc/kitchen-2.webp';
import k3 from '../../assets/svc/kitchen-3.webp';
import k4 from '../../assets/svc/kitchen-4.webp';
import b1 from '../../assets/svc/bathroom-1.webp';
import b2 from '../../assets/svc/bathroom-2.webp';
import b3 from '../../assets/svc/bathroom-3.webp';
import b4 from '../../assets/svc/bathroom-4.webp';
import d1 from '../../assets/svc/decking-1.webp';
import d2 from '../../assets/svc/decking-2.webp';
import d3 from '../../assets/svc/decking-3.webp';
import d4 from '../../assets/svc/decking-4.webp';
import f1 from '../../assets/svc/flooring-1.webp';
import f2 from '../../assets/svc/flooring-2.webp';
import f3 from '../../assets/svc/flooring-3.webp';
import f4 from '../../assets/svc/flooring-4.webp';
import t1 from '../../assets/svc/tiling-1.webp';
import t2 from '../../assets/svc/tiling-2.webp';
import t3 from '../../assets/svc/tiling-3.webp';
import t4 from '../../assets/svc/tiling-4.webp';
import g1 from '../../assets/svc/granny-1.webp';
import g2 from '../../assets/svc/granny-2.webp';
import g3 from '../../assets/svc/granny-3.webp';
import g4 from '../../assets/svc/granny-4.webp';

// Finished rooms, shared with the services overview page
import roomKitchen from '../../assets/services/svc-kitchen.webp';
import roomBathroom from '../../assets/services/svc-bathroom.webp';
import roomDecking from '../../assets/services/svc-decking.webp';
import roomFlooring from '../../assets/services/svc-flooring.webp';
import roomTiling from '../../assets/services/svc-tiling.webp';
import roomGranny from '../../assets/services/svc-granny.webp';

// Before and after pairs, shared with the projects page
import baKitchenB from '../../assets/projects/ba/kitchen-before.webp';
import baKitchenA from '../../assets/projects/ba/kitchen-after.webp';
import baBathroomB from '../../assets/projects/ba/bathroom-before.webp';
import baBathroomA from '../../assets/projects/ba/bathroom-after.webp';
import baDeckingB from '../../assets/projects/ba/decking-before.webp';
import baDeckingA from '../../assets/projects/ba/decking-after.webp';
import baFlooringB from '../../assets/projects/ba/flooring-before.webp';
import baFlooringA from '../../assets/projects/ba/flooring-after.webp';
import baTilingB from '../../assets/projects/ba/tiling-before.webp';
import baTilingA from '../../assets/projects/ba/tiling-after.webp';
import baGrannyB from '../../assets/projects/ba/granny-before.webp';
import baGrannyA from '../../assets/projects/ba/granny-after.webp';

const art = {
  kitchen: { hero: heroKitchen, band: bandKitchen, blocks: [k1, k2, k3, k4], room: roomKitchen, ba: [baKitchenB, baKitchenA] },
  bathroom: { hero: heroBathroom, band: bandBathroom, blocks: [b1, b2, b3, b4], room: roomBathroom, ba: [baBathroomB, baBathroomA] },
  decking: { hero: heroDecking, band: bandDecking, blocks: [d1, d2, d3, d4], room: roomDecking, ba: [baDeckingB, baDeckingA] },
  flooring: { hero: heroFlooring, band: bandFlooring, blocks: [f1, f2, f3, f4], room: roomFlooring, ba: [baFlooringB, baFlooringA] },
  tiling: { hero: heroTiling, band: bandTiling, blocks: [t1, t2, t3, t4], room: roomTiling, ba: [baTilingB, baTilingA] },
  granny: { hero: heroGranny, band: bandGranny, blocks: [g1, g2, g3, g4], room: roomGranny, ba: [baGrannyB, baGrannyA] },
};

const roomAlt = {
  kitchen: 'A completed kitchen with charcoal cabinetry, a stone island and warm pendant lighting',
  bathroom: 'A completed bathroom with stone tiling, a walk in shower and a backlit mirror',
  decking: 'A completed merbau deck at dusk with warm lighting and steps down to the lawn',
  flooring: 'Wide engineered oak flooring running through a living room at dusk',
  tiling: 'Large format floor tiling with tight grout lines running down a hallway',
  granny: 'A completed granny flat in a backyard at dusk with warm light in the windows',
};

const heroAlt = {
  kitchen: 'A completed dark luxury kitchen at dusk with a stone island and brass pendants',
  bathroom: 'A completed dark luxury bathroom with a frameless walk in shower and a backlit mirror',
  decking: 'A merbau deck at dusk with lit stair risers and a wire balustrade',
  flooring: 'Wide oak flooring running through a dark open plan living room at dusk',
  tiling: 'A large format tiled hallway with perfectly straight grout lines running away from camera',
  granny: 'A modern granny flat in a backyard at dusk with warm light in the windows',
};

const bandAlt = {
  kitchen: 'Kitchen cabinets levelled on packers with a laser line across the run and a stone template on trestles',
  bathroom: 'A bathroom with the waterproofing membrane applied to the floor, hob and lower walls',
  decking: 'A hardwood deck subframe set out square on stirrups with the first boards laid',
  flooring: 'Engineered oak flooring half laid across a living room with the underlay visible ahead',
  tiling: 'A room set out for tiling with chalk lines from the centre and tiles stacked at the wall',
  granny: 'A granny flat timber frame standing on a finished slab with the roof trusses set',
};

export function getStaticPaths() {
  return servicePages.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props;
const a = art[s.key];
const related = s.related
  .map((slug) => servicePages.find((x) => x.slug === slug))
  .filter(Boolean);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    description: s.description,
    provider: { '@type': 'GeneralContractor', name: business.name, telephone: business.phone },
    areaServed: { '@type': 'City', name: 'Sydney' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Services', item: '/services' },
      { '@type': 'ListItem', position: 2, name: s.name, item: `/services/${s.slug}` },
    ],
  },
];

const hasIllustrative = s.specs.some((x) => x.illustrative) || s.faqs.some((x) => x.illustrative);
---

<Base title={s.title} description={s.description}>
  <Header />
  <main id="main">
    <PageHero
      eyebrow={s.hero.eyebrow}
      lines={s.hero.lines}
      lede={s.hero.lede}
      image={a.hero}
      imageAlt={heroAlt[s.key]}
      cta={{ label: 'Request a quote', href: '/contact' }}
      secondary={{ label: 'See our process', href: '/process' }}
      facts={s.hero.facts}
    />

    <nav class="crumb shell" aria-label="Breadcrumb">
      <a href="/services">Services</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page">{s.name}</span>
    </nav>

    <!-- Intro -->
    <section class="section intro" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">01 / The short version</span>
          <span class="setout-rule"></span>
        </div>

        <div class="intro-grid">
          <div class="intro-txt">
            <h2 class="display display-l rise">{s.intro.heading}</h2>
            {s.intro.body.map((p, i) => (
              <p class={`intro-p rise rise-${i + 2}`}>{p}</p>
            ))}
            <a class="btn btn-ghost rise rise-4 intro-btn" href="/contact">
              <span>Get a fixed price</span><i class="btn-arrow"></i>
            </a>
          </div>

          <figure class="intro-fig rise rise-2">
            <Image
              src={a.room}
              alt={roomAlt[s.key]}
              widths={[500, 900, 1400]}
              sizes="(max-width: 980px) 100vw, 42vw"
              quality={80}
            />
            <figcaption class="annot">{s.short} · finished work</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Full bleed band with the line that matters -->
    <section class="band" data-reveal>
      <Image
        src={a.band}
        alt={bandAlt[s.key]}
        widths={[1200, 1800, 2400, 2772]}
        sizes="100vw"
        quality={78}
      />
      <div class="band-veil" aria-hidden="true"></div>
      <div class="shell band-in">
        <p class="display band-q rise">{s.intro.pull}</p>
      </div>
    </section>

    <!-- What is included -->
    <section class="section inc" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">02 / What is included</span>
          <span class="setout-rule"></span>
        </div>

        <div class="inc-grid">
          {s.blocks.map((b, i) => (
            <article class={`inc-card rise rise-${Math.min(i + 1, 4)}`}>
              <figure class="inc-fig">
                <Image
                  src={a.blocks[b.img - 1]}
                  alt={b.alt}
                  widths={[400, 700, 1100]}
                  sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 32vw"
                  quality={80}
                />
                <span class="inc-n annot">{String(i + 1).padStart(2, '0')}</span>
              </figure>
              <div class="inc-body">
                <h3 class="display display-m inc-h">{b.title}</h3>
                <p class="inc-p">{b.body}</p>
                <ul class="inc-list">
                  {b.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>

        <div class="also">
          <h3 class="annot also-h">Also covered</h3>
          <ul class="also-list">
            {s.also.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- How the job runs -->
    <section class="section run" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">03 / {s.run.heading}</span>
          <span class="setout-rule"></span>
        </div>

        <ol class="run-grid">
          {s.run.steps.map((st, i) => (
            <li class={`run-step rise rise-${Math.min(i + 1, 4)}`}>
              <span class="run-n">{st.n}</span>
              <h3 class="run-h display">{st.title}</h3>
              <p class="run-p">{st.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Materials -->
    <section class="section mats" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">04 / {s.materials.heading}</span>
          <span class="setout-rule"></span>
        </div>

        <dl class="mats-grid">
          {s.materials.items.map((m, i) => (
            <div class={`mat rise rise-${Math.min(i + 1, 4)}`}>
              <dt class="mat-n display">{m.name}</dt>
              <dd class="mat-d">{m.note}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Before and after -->
    <section class="section ba-sec" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">05 / Before and after</span>
          <span class="setout-rule"></span>
        </div>

        <div class="ba-grid">
          <div class="ba-txt">
            <h2 class="display display-l rise">Drag it across.</h2>
            <p class="lede rise rise-2">{s.ba.caption}</p>
            <p class="annot ba-flag rise rise-3">
              <span class="annot-signal">Placeholder</span> · An illustrative pair, not a
              record of a job we have done. See the
              <a href="/illustrative-content">full list</a>.
            </p>
          </div>

          <div class="ba-wrap rise rise-2">
            <BeforeAfter before={a.ba[0]} after={a.ba[1]} alt={s.ba.alt} label={s.slug} />
          </div>
        </div>
      </div>
    </section>

    <!-- Specifications -->
    <section class="section spec" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">06 / The numbers</span>
          <span class="setout-rule"></span>
        </div>

        <dl class="spec-grid">
          {s.specs.map((x, i) => (
            <div class={`spec-cell rise rise-${Math.min(i + 1, 4)}`}>
              <dt class="annot">{x.k}</dt>
              <dd class="spec-v display">
                {x.v}
                {x.illustrative && <span class="spec-flag" title="Placeholder figure">*</span>}
              </dd>
            </div>
          ))}
        </dl>

        {hasIllustrative && (
          <p class="annot spec-note">
            * Placeholder figure for the site build. Confirm before launch.
          </p>
        )}
      </div>
    </section>

    <!-- FAQs -->
    <section class="section faq-sec" data-reveal>
      <div class="shell faq-shell">
        <div class="setout">
          <span class="annot">07 / {s.short} questions</span>
          <span class="setout-rule"></span>
        </div>

        <ul class="faq-list">
          {s.faqs.map((f, i) => (
            <li class="faq rise">
              <details name="svcfaq" open={i === 0}>
                <summary>
                  <span class="faq-q display">{f.q}</span>
                  <span class="faq-icon" aria-hidden="true"><i></i><i></i></span>
                </summary>
                <div class="faq-a">
                  <p>{f.a}</p>
                  {f.illustrative && (
                    <p class="faq-flag annot">Placeholder figure, replace before launch</p>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>

        <p class="annot faq-more">
          More on the <a href="/faqs">general FAQs page</a>, or just call
          <a href={business.phoneHref}>{business.phone}</a>.
        </p>
      </div>
    </section>

    <!-- Related services -->
    <section class="section rel" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">08 / Usually booked together</span>
          <span class="setout-rule"></span>
        </div>

        <ul class="rel-grid">
          {related.map((r, i) => (
            <li class={`rise rise-${i + 1}`}>
              <a class="rel-card" href={`/services/${r.slug}`}>
                <figure class="rel-fig">
                  <Image
                    src={art[r.key].room}
                    alt={roomAlt[r.key]}
                    widths={[400, 700, 1000]}
                    sizes="(max-width: 760px) 100vw, 30vw"
                    quality={78}
                  />
                </figure>
                <span class="rel-name display">{r.name}</span>
                <span class="rel-go annot">View <i class="btn-arrow"></i></span>
              </a>
            </li>
          ))}
        </ul>

        <p class="annot rel-kw">
          People also search for: {s.keywords.join(' · ')}
        </p>
      </div>
    </section>

    <CtaBand title={s.cta.title} body={s.cta.body} />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
  /* Breadcrumb */
  .crumb {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding-top: 1.75rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .crumb a {
    color: var(--bone-2);
    transition: color 0.3s var(--ease);
  }

  .crumb a:hover,
  .crumb a:focus-visible {
    color: var(--signal);
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .intro-txt .display-l {
    max-width: 18ch;
    margin-bottom: 1.5rem;
  }

  .intro-p {
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.68;
    max-width: 58ch;
  }

  .intro-p + .intro-p {
    margin-top: 1rem;
  }

  .intro-btn {
    margin-top: 1.75rem;
  }

  .intro-fig {
    margin: 0;
    border-left: 2px solid var(--signal);
  }

  .intro-fig :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .intro-fig figcaption {
    padding-top: 0.75rem;
  }

  /* Full bleed band */
  .band {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
  }

  .band :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    height: auto;
    object-fit: cover;
    display: block;
    transform: scale(1.03);
    transition: transform 1.6s var(--ease);
  }

  .band.is-in :global(img) {
    transform: scale(1);
  }

  .band-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--ink) 66%, transparent) 48%,
      color-mix(in srgb, var(--ink) 24%, transparent) 100%
    );
  }

  .band-in {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .band-q {
    font-variation-settings: 'wdth' 104, 'wght' 700;
    font-size: clamp(1.25rem, 3.1vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 20ch;
    text-wrap: balance;
  }

  /* Inclusions */
  .inc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    background: var(--line);
    border: 1px solid var(--line);
  }

  .inc-card {
    background: var(--charcoal);
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .inc-fig {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .inc-fig :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform 1.1s var(--ease);
  }

  .inc-card:hover .inc-fig :global(img) {
    transform: scale(1.05);
  }

  .inc-n {
    position: absolute;
    left: 0;
    bottom: 0;
    background: var(--signal);
    color: var(--ink);
    padding: 0.4rem 0.6rem;
    font-size: 0.625rem;
  }

  .inc-body {
    padding: 1.5rem 1.375rem 1.625rem;
    display: grid;
    align-content: start;
    gap: 0.875rem;
  }

  .inc-h {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    letter-spacing: -0.012em;
  }

  .inc-p {
    color: var(--bone-2);
    font-size: 0.875rem;
    line-height: 1.62;
  }

  .inc-list {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .inc-list li {
    font-size: 0.8125rem;
    color: var(--bone);
    padding-left: 0.9rem;
    position: relative;
  }

  .inc-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 4px;
    height: 4px;
    background: var(--signal);
    transform: rotate(45deg);
  }

  /* Also covered */
  .also {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .also-h {
    margin-bottom: 1rem;
  }

  .also-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .also-list li {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--bone-2);
    border: 1px solid var(--line-lift);
    padding: 0.45rem 0.75rem;
  }

  /* How it runs */
  .run {
    background: var(--charcoal);
    border-top: 1px solid var(--line);
  }

  .run-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .run-step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-lift);
  }

  .run-n {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--signal);
  }

  .run-h {
    font-variation-settings: 'wdth' 100, 'wght' 650;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin: 0.6rem 0 0.5rem;
  }

  .run-p {
    color: var(--bone-2);
    font-size: 0.875rem;
    line-height: 1.62;
  }

  /* Materials */
  .mats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    background: var(--line);
    border: 1px solid var(--line);
    margin: 0;
  }

  .mat {
    background: var(--surface);
    padding: 1.375rem 1.25rem 1.5rem;
  }

  .mat-n {
    font-variation-settings: 'wdth' 104, 'wght' 700;
    text-transform: uppercase;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    color: var(--bone);
  }

  .mat-d {
    margin: 0.55rem 0 0;
    color: var(--bone-2);
    font-size: 0.8438rem;
    line-height: 1.6;
  }

  /* Before and after */
  .ba-grid {
    display: grid;
