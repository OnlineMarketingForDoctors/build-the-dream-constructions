---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Thesis from '../components/Thesis.astro';
import Services from '../components/Services.astro';
import Why from '../components/Why.astro';
import Projects from '../components/Projects.astro';
import Testimonials from '../components/Testimonials.astro';
import Process from '../components/Process.astro';
import Areas from '../components/Areas.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Build The Dream Constructions | Renovations across Sydney"
  description="Sydney renovation builder since 2008. Kitchens, bathrooms, decking, flooring and tiling under one contract, with a fixed quote and a written variation before anything changes."
>
  <Header />
  <main id="main">
    <Hero />
    <Thesis />
    <Services />
    <Why />
    <Projects />
    <Testimonials />
    <Process />
    <Areas />
    <Quote />
  </main>
  <Footer />
</Base>
