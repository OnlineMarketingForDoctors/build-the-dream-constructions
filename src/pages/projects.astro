---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroImg from '../assets/pages/hero-projects.webp';
import { projects, projectCategories } from '../data/pages.js';

const ba = import.meta.glob('../assets/projects/ba/*.webp', { eager: true, import: 'default' });
const pick = (key) => ({
  before: ba[`../assets/projects/ba/${key}-before.webp`],
  after: ba[`../assets/projects/ba/${key}-after.webp`],
});
const keyFor = {
  Kitchens: 'kitchen',
  Bathrooms: 'bathroom',
  Decking: 'decking',
  Flooring: 'flooring',
  Tiling: 'tiling',
  'Granny Flats': 'granny',
};
---

<Base
  title="Projects | Build The Dream Constructions"
  description="Renovation projects across Sydney, shown before and after, with the scope of works, timeframe and the problem each job had to solve."
>
  <Header />
  <main id="main">
    <PageHero
      eyebrow='<span class="annot-signal">Projects</span> · Before and after'
      lines={['Drag the', 'line to see', '<em>the change.</em>']}
      lede="Each project below lists the scope of works, the timeframe and the problem the job actually had to solve. Drag the handle on any image to compare."
      image={heroImg}
      imageAlt="A completed open plan living space at dusk with warm pendant lighting"
      cta={{ label: 'Request a quote', href: '/contact' }}
      secondary={{ label: 'See our services', href: '/services' }}
    />

    <div class="notice shell" role="note">
      <p class="annot">
        <span class="annot-signal">Placeholder content</span> · The projects on this page are
        illustrative while the site is in development. Replace with real jobs and photographs
        before launch.
      </p>
    </div>

    <section class="section" id="work" data-reveal>
      <div class="shell">
        <div class="setout">
          <span class="annot">Selected work</span>
          <span class="setout-rule"></span>
        </div>

        <div class="filters" role="group" aria-label="Filter projects by category">
          {projectCategories.map((c, i) => (
            <button
              class="filter"
              type="button"
              data-cat={c}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c}
            </button>
          ))}
        </div>

        <ul class="prj-list">
          {projects.map((p) => (
            <li class="prj" data-category={p.category}>
              <BeforeAfter {...pick(keyFor[p.category])} alt={p.title} label={p.slug} />

              <div class="prj-meta">
                <div class="prj-head">
                  <span class="annot annot-signal">{p.category}</span>
                  <h2 class="display prj-title">{p.title}</h2>
                </div>

                <dl class="prj-facts">
                  <div><dt class="annot">Location</dt><dd>{p.location}</dd></div>
                  <div><dt class="annot">Timeframe</dt><dd>{p.timeframe}</dd></div>
                  <div><dt class="annot">Scope</dt><dd>{p.scope}</dd></div>
                </dl>

                <div class="prj-challenge">
                  <span class="annot">Problem solved</span>
                  <p>{p.challenge}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <p class="empty annot" hidden>No projects in that category yet.</p>
      </div>
    </section>

    <CtaBand
      title="Want to see something like this at your place?"
      body="Tell us about the room and we will come and measure it. The quote comes back itemised, with an estimated start and finish date."
    />
  </main>
  <Footer />
</Base>

<style>
  .notice {
    padding-top: 2rem;
  }

  .notice p {
    border-left: 2px solid var(--signal);
    padding: 0.85rem 1rem;
    background: var(--surface);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--bone-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .filter {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.6rem 1rem;
    background: none;
    border: 1px solid var(--line-lift);
    color: var(--bone-2);
    cursor: pointer;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), background 0.3s var(--ease);
  }

  .filter:hover {
    color: var(--bone);
    border-color: var(--bone-2);
  }

  .filter[aria-pressed='true'] {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }

  .prj-list {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .prj {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .prj[hidden] {
    display: none;
  }

  .prj-meta {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .prj-head {
    display: grid;
    gap: 0.5rem;
  }

  .prj-title {
    font-size: clamp(1.375rem, 2vw, 1.875rem);
  }

  .prj-facts {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-lift);
  }

  .prj-facts div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .prj-facts dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--bone);
  }

  .prj-challenge {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .prj-challenge p {
    color: var(--bone-2);
    font-size: 0.9375rem;
    line-height: 1.62;
  }

  .empty {
    padding-top: 3rem;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .prj {
      grid-template-columns: 1fr;
    }
    .prj-facts div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

<script>
  const buttons = [...document.querySelectorAll('.filter')];
  const items = [...document.querySelectorAll('.prj')];
  const empty = document.querySelector('.empty');

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.cat;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      items.forEach((li) => {
        const on = cat === 'All' || li.dataset.category === cat;
        li.hidden = !on;
        if (on) shown += 1;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>
