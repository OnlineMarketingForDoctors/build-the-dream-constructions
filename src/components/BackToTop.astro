---
// Appears once you are a screen or so down the page. Sits bottom right and
// keeps clear of the footer content on short pages.
---

<button class="totop" type="button" aria-label="Back to top" hidden>
  <span class="totop-arrow" aria-hidden="true"></span>
  <span class="totop-line" aria-hidden="true"></span>
</button>

<style>
  .totop {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 90;

    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    gap: 0;

    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-lift);
    color: var(--signal);
    cursor: pointer;
    padding: 0;

    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease),
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .totop[hidden] {
    display: none;
  }

  .totop.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Arrowhead and shaft, drawn to match the setout marks elsewhere. */
  .totop-arrow {
    grid-area: 1 / 1;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: translateY(-3px) rotate(-45deg);
    transition: transform 0.35s var(--ease);
  }

  .totop-line {
    grid-area: 1 / 1;
    width: 1.5px;
    height: 15px;
    background: currentColor;
    transform: translateY(2px);
    transition: transform 0.35s var(--ease);
  }

  .totop:hover,
  .totop:focus-visible {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }

  .totop:hover .totop-arrow {
    transform: translateY(-5px) rotate(-45deg);
  }

  .totop:hover .totop-line {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .totop,
    .totop-arrow,
    .totop-line {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector('.totop');
  if (btn) {
    btn.hidden = false;

    let ticking = false;
    const update = () => {
      btn.classList.toggle('is-on', window.scrollY > window.innerHeight * 0.9);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });

    btn.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Send focus back to the top of the document so keyboard users land there too.
      document.getElementById('main')?.focus?.();
    });
  }
</script>
