---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-mark.png';
import { business } from '../data/site.js';

const nav = [
  { label: 'Services', href: '#services' },
  { label: 'Why us', href: '#why' },
  { label: 'Projects', href: '#projects' },
  { label: 'Process', href: '#process' },
  { label: 'Areas', href: '#areas' },
];
---

<header class="hdr" id="hdr">
  <div class="hdr-in">
    <a class="brand" href="/" aria-label={`${business.name}, home`}>
      <Image src={mark} alt="" width={40} densities={[1, 2, 3]} />
      <span class="brand-txt">
        <span class="brand-1">Build the</span>
        <span class="brand-2">Dream</span>
        <span class="brand-3">Constructions</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((i) => (
        <a href={i.href}>{i.label}</a>
      ))}
    </nav>

    <div class="hdr-act">
      <a class="tel" href={business.phoneHref}>
        <span class="tel-dot" aria-hidden="true"></span>
        {business.phone}
      </a>
      <a class="btn hdr-cta" href="#quote"><span>Request a quote</span><i class="btn-arrow"></i></a>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu">
      <span></span><span></span>
    </button>

    <a class="tel-m" href={business.phoneHref} aria-label={`Call ${business.phone}`}>
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"
        ></path>
      </svg>
    </a>
  </div>

  <div class="mnav" id="mnav" hidden>
    {nav.map((i) => (
      <a href={i.href}>{i.label}</a>
    ))}
    <a class="mnav-cta" href="#quote">Request a quote</a>
    <a class="mnav-tel" href={business.phoneHref}>{business.phone}</a>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background 0.45s var(--ease), border-color 0.45s var(--ease);
  }

  .hdr.is-stuck {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  /* Three tracks so the lockup sits on the true centre of the page,
     regardless of how wide the nav or the actions happen to be. */
  .hdr-in {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0.875rem var(--pad-x);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    transition: padding 0.45s var(--ease);
  }

  .hdr.is-stuck .hdr-in {
    padding-block: 0.5rem;
  }

  /* The whole lockup scales from one number, so the shrink on scroll stays
     proportional and still changes the header's actual height. */
  /* Every item is pinned to row 1, otherwise auto-placement drops the nav
     onto a second row once the brand has claimed column 2. */
  .brand,
  .nav,
  .hdr-act,
  .burger,
  .tel-m {
    grid-row: 1;
  }

  .brand {
    --bs: 1;
    grid-column: 2;
    display: grid;
    justify-items: center;
    gap: calc(0.3rem * var(--bs));
    text-align: center;
  }

  .hdr.is-stuck .brand {
    --bs: 0.76;
  }

  .brand :global(img) {
    width: calc(40px * var(--bs));
    height: auto;
    transition: width 0.45s var(--ease);
  }

  .brand-txt {
    display: grid;
    justify-items: center;
    line-height: 0.98;
    font-family: var(--display);
    text-transform: uppercase;
  }

  .brand-1,
  .brand-2,
  .brand-3 {
    transition: font-size 0.45s var(--ease);
    white-space: nowrap;
  }

  .brand-1 {
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: calc(0.6875rem * var(--bs));
    letter-spacing: 0.2em;
    text-indent: 0.2em;
    color: var(--signal);
  }

  .brand-2 {
    font-variation-settings: 'wdth' 112, 'wght' 800;
    font-size: calc(1.375rem * var(--bs));
    letter-spacing: 0.005em;
  }

  .brand-3 {
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: calc(0.5625rem * var(--bs));
    letter-spacing: 0.135em;
    text-indent: 0.135em;
    color: var(--signal);
  }

  .nav {
    grid-column: 1;
    justify-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
  }

  .nav a {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-2);
    padding-block: 0.35rem;
    position: relative;
    transition: color 0.3s var(--ease);
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-snap);
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--bone);
  }

  .nav a:hover::after,
  .nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .hdr-act {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tel {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .tel-dot {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    animation: pulse 2.8s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent); }
    70% { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hdr-cta {
    padding: 0.8125rem 1.25rem;
    font-size: 0.6875rem;
  }

  .burger,
  .tel-m {
    display: none;
    width: 42px;
    height: 42px;
    background: none;
    border: 1px solid var(--line-lift);
    cursor: pointer;
    padding: 0;
    place-content: center;
    place-items: center;
    gap: 5px;
    color: var(--bone);
  }

  .burger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--bone);
    transition: transform 0.35s var(--ease);
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mnav {
    display: none;
    gap: 0.25rem;
    padding: 1rem var(--pad-x) 2rem;
    background: var(--charcoal);
    border-top: 1px solid var(--line);
  }

  .mnav a {
    font-family: var(--display);
    font-variation-settings: 'wdth' 106, 'wght' 700;
    text-transform: uppercase;
    font-size: 1.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .mnav-cta {
    color: var(--signal);
  }

  .mnav-tel {
    font-family: var(--mono) !important;
    font-size: 1rem !important;
    border-bottom: 0 !important;
    color: var(--bone-2);
  }

  /* Narrow desktop: drop the phone number before the nav starts wrapping. */
  @media (max-width: 1320px) {
    .tel {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .nav,
    .hdr-act {
      display: none;
    }
    .burger {
      display: grid;
      grid-column: 1;
      justify-self: start;
    }
    .tel-m {
      display: grid;
      grid-column: 3;
      justify-self: end;
    }
    .mnav:not([hidden]) {
      display: grid;
    }
    .hdr {
      background: color-mix(in srgb, var(--ink) 88%, transparent);
      backdrop-filter: blur(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tel-dot {
      animation: none;
    }
  }
</style>

<script>
  const hdr = document.getElementById('hdr');
  const burger = hdr?.querySelector('.burger');
  const mnav = document.getElementById('mnav');

  const onScroll = () => hdr?.classList.toggle('is-stuck', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mnav) mnav.hidden = open;
  });

  mnav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      burger?.setAttribute('aria-expanded', 'false');
      if (mnav) mnav.hidden = true;
    }),
  );
</script>
