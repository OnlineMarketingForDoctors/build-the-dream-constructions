---
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-mark.png';
import { business } from '../data/site.js';
import { servicePages } from '../data/servicePages.js';

// Services carries a submenu of the six dedicated service pages. The parent is
// still a real link to the overview, so the dropdown is an addition rather than
// the only way through.
const nav = [
  { label: 'About', href: '/about' },
  {
    label: 'Services',
    href: '/services',
    sub: [
      ...servicePages.map((s) => ({ label: s.name, href: `/services/${s.slug}` })),
      { label: 'All services', href: '/services', muted: true },
    ],
  },
  { label: 'Projects', href: '/projects' },
  { label: 'Process', href: '/process' },
  { label: 'Areas', href: '/areas' },
  { label: 'Reviews', href: '/testimonials' },
  { label: 'FAQs', href: '/faqs' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="hdr" id="hdr">
  <div class="hdr-in">
    <a class="brand" href="/" aria-label={`${business.name}, home`}>
      <Image src={mark} alt="" width={40} densities={[1, 2, 3]} />
      <span class="brand-txt">
        <span class="brand-1">Build the</span>
        <span class="brand-2">Dream</span>
        <span class="brand-3">Constructions</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((i) =>
        i.sub ? (
          <div class="has-sub" data-sub>
            <a class="nav-top" href={i.href}>{i.label}</a>
            <button
              class="sub-tog"
              type="button"
              aria-expanded="false"
              aria-label={`${i.label} submenu`}
              data-sub-tog
            >
              <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"></path>
              </svg>
            </button>

            <div class="sub" data-sub-panel>
              <ul class="sub-in">
                {i.sub.map((c) => (
                  <li><a class={c.muted ? 'sub-all' : ''} href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a class="nav-top" href={i.href}>{i.label}</a>
        ),
      )}
    </nav>

    <div class="hdr-act">
      <a class="tel" href={business.phoneHref}>
        <span class="tel-dot" aria-hidden="true"></span>
        {business.phone}
      </a>
      <a class="btn hdr-cta" href="/contact"><span>Request a quote</span><i class="btn-arrow"></i></a>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu">
      <span></span><span></span>
    </button>

    <a class="tel-m" href={business.phoneHref} aria-label={`Call ${business.phone}`}>
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <path
          fill="currentColor"
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"
        ></path>
      </svg>
    </a>
  </div>

  <div class="mnav" id="mnav" hidden>
    {nav.map((i) =>
      i.sub ? (
        <div class="mnav-grp">
          <a href={i.href}>{i.label}</a>
          <ul class="mnav-sub">
            {i.sub
              .filter((c) => !c.muted)
              .map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
          </ul>
        </div>
      ) : (
        <a href={i.href}>{i.label}</a>
      ),
    )}
    <a class="mnav-cta" href="/contact">Request a quote</a>
    <a class="mnav-tel" href={business.phoneHref}>{business.phone}</a>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background 0.45s var(--ease), border-color 0.45s var(--ease);
  }

  .hdr.is-stuck {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  /* Three tracks: lockup left, nav on the true centre of the page, actions
     right. The outer tracks are equal so the nav stays centred even though
     the two sides carry different amounts of content. */
  .hdr-in {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0.875rem var(--pad-x);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    transition: padding 0.45s var(--ease);
  }

  .hdr.is-stuck .hdr-in {
    padding-block: 0.5rem;
  }

  /* The whole lockup scales from one number, so the shrink on scroll stays
     proportional and still changes the header's actual height. */
  /* Every item is pinned to row 1, otherwise auto-placement drops the nav
     onto a second row once the brand has claimed column 2. */
  .brand,
  .nav,
  .hdr-act,
  .burger,
  .tel-m {
    grid-row: 1;
  }

  /* Horizontal lockup: mark beside the three stacked wordmark lines. */
  .brand {
    --bs: 1;
    grid-column: 1;
    justify-self: start;
    display: flex;
    align-items: center;
    gap: calc(0.7rem * var(--bs));
  }

  .hdr.is-stuck .brand {
    --bs: 0.86;
  }

  .brand :global(img) {
    width: calc(54px * var(--bs));
    height: auto;
    transition: width 0.45s var(--ease);
  }

  .brand-txt {
    display: grid;
    line-height: 0.92;
    font-family: var(--display);
    text-transform: uppercase;
  }

  .brand-1,
  .brand-2,
  .brand-3 {
    transition: font-size 0.45s var(--ease);
    white-space: nowrap;
  }

  /* All three lines are set to the same width, as they are in the logo.
     Sizes follow the logo's own cap height ratio (119 : 172 : 80). Dream is
     the widest line naturally, so it sets the target and keeps its normal
     spacing; the other two are tracked out to meet it. The values were
     solved against the rendered font rather than eyeballed, so they land
     within a twentieth of a pixel of each other. */
  .brand-1 {
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: calc(1.0375rem * var(--bs));
    letter-spacing: 0.1088em;
    color: var(--signal);
  }

  .brand-2 {
    font-variation-settings: 'wdth' 112, 'wght' 800;
    font-size: calc(1.5rem * var(--bs));
    letter-spacing: 0;
  }

  .brand-3 {
    font-variation-settings: 'wdth' 100, 'wght' 700;
    font-size: calc(0.7rem * var(--bs));
    letter-spacing: 0.0262em;
    color: var(--signal);
  }

  .nav {
    grid-column: 2;
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem 1.15rem;
  }

  .nav-top {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-2);
    padding-block: 0.35rem;
    position: relative;
    transition: color 0.3s var(--ease);
  }

  .nav-top::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-snap);
  }

  .nav-top:hover,
  .nav-top:focus-visible {
    color: var(--bone);
  }

  .nav-top:hover::after,
  .nav-top:focus-visible::after {
    transform: scaleX(1);
  }

  /* ---------------------------------------------------------------
     Services dropdown
     --------------------------------------------------------------- */

  .has-sub {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .sub-tog {
    background: none;
    border: 0;
    padding: 0.35rem 0.1rem;
    color: var(--bone-2);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition:
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .has-sub:hover .sub-tog,
  .sub-tog:focus-visible {
    color: var(--signal);
  }

  .has-sub:hover .sub-tog,
  .sub-tog[aria-expanded='true'] {
    transform: rotate(180deg);
  }

  /* The panel sits under the whole header bar. The padding on the wrapper is
     transparent, so the pointer can cross the gap without the menu closing. */
  .sub {
    position: absolute;
    top: 100%;
    left: -1rem;
    padding-top: 1.15rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.28s var(--ease),
      transform 0.28s var(--ease),
      visibility 0.28s;
  }

  .has-sub:hover .sub,
  .has-sub:focus-within .sub,
  .has-sub.is-open .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sub-in {
    min-width: 15rem;
    background: color-mix(in srgb, var(--charcoal) 97%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line-lift);
    border-top: 2px solid var(--signal);
    padding: 0.4rem 0;
    display: grid;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.75);
  }

  .sub-in a {
    display: block;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-2);
    padding: 0.6rem 1rem 0.6rem 0.9rem;
    border-left: 2px solid transparent;
    white-space: nowrap;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .sub-in a:hover,
  .sub-in a:focus-visible {
    color: var(--bone);
    border-left-color: var(--signal);
    background: var(--surface);
  }

  .sub-in .sub-all {
    color: var(--muted);
    border-top: 1px solid var(--line);
    margin-top: 0.35rem;
    padding-top: 0.7rem;
  }

  .sub-in .sub-all:hover,
  .sub-in .sub-all:focus-visible {
    color: var(--signal);
  }

  .hdr-act {
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tel {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .tel-dot {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    animation: pulse 2.8s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent); }
    70% { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hdr-cta {
    padding: 0.8125rem 1.25rem;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .burger,
  .tel-m {
    display: none;
    width: 42px;
    height: 42px;
    background: none;
    border: 1px solid var(--line-lift);
    cursor: pointer;
    padding: 0;
    place-content: center;
    place-items: center;
    gap: 5px;
    color: var(--bone);
  }

  .burger span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--bone);
    transition: transform 0.35s var(--ease);
  }

  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mnav {
    display: none;
    gap: 0.25rem;
    padding: 1rem var(--pad-x) 2rem;
    background: var(--charcoal);
    border-top: 1px solid var(--line);
  }

  .mnav a {
    font-family: var(--display);
    font-variation-settings: 'wdth' 106, 'wght' 700;
    text-transform: uppercase;
    font-size: 1.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  /* Services and its children on mobile. No toggle, the list is just there. */
  .mnav-grp {
    display: grid;
  }

  .mnav-sub {
    display: grid;
    padding: 0.5rem 0 0.65rem 0.9rem;
    border-left: 2px solid var(--signal);
    margin: 0.6rem 0 0.5rem;
    gap: 0.1rem;
  }

  .mnav-sub a {
    font-family: var(--mono) !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-2);
    border-bottom: 0 !important;
    padding-block: 0.4rem !important;
  }

  .mnav-sub a:hover,
  .mnav-sub a:focus-visible {
    color: var(--signal);
  }

  .mnav-cta {
    color: var(--signal);
  }

  .mnav-tel {
    font-family: var(--mono) !important;
    font-size: 1rem !important;
    border-bottom: 0 !important;
    color: var(--bone-2);
  }

  /* Narrow desktop: drop the phone number before the nav starts crowding the
     quote button. Shortening the last nav label bought back enough room to
     keep the number visible down to 1340 rather than 1560. */
  @media (max-width: 1340px) {
    .tel {
      display: none;
    }
  }

  @media (max-width: 1240px) {
    .nav,
    .hdr-act {
      display: none;
    }
    .hdr-in {
      grid-template-columns: 1fr auto auto;
      gap: 0.5rem;
    }
    .tel-m {
      display: grid;
      grid-column: 2;
      justify-self: end;
    }
    .burger {
      display: grid;
      grid-column: 3;
      justify-self: end;
    }
    .mnav:not([hidden]) {
      display: grid;
    }
    .hdr {
      background: color-mix(in srgb, var(--ink) 88%, transparent);
      backdrop-filter: blur(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tel-dot {
      animation: none;
    }
  }
</style>

<script>
  const hdr = document.getElementById('hdr');
  const burger = hdr?.querySelector('.burger');
  const mnav = document.getElementById('mnav');

  const onScroll = () => hdr?.classList.toggle('is-stuck', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (mnav) mnav.hidden = open;
  });

  mnav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      burger?.setAttribute('aria-expanded', 'false');
      if (mnav) mnav.hidden = true;
    }),
  );

  // Services dropdown. Hover and keyboard focus are handled in CSS; this adds
  // click, which is what a touch device on a wide screen actually sends.
  const subs = hdr?.querySelectorAll('[data-sub]') ?? [];

  const closeSubs = (except?: Element) => {
    subs.forEach((s) => {
      if (s === except) return;
      s.classList.remove('is-open');
      s.querySelector('[data-sub-tog]')?.setAttribute('aria-expanded', 'false');
    });
  };

  subs.forEach((sub) => {
    const tog = sub.querySelector('[data-sub-tog]');

    tog?.addEventListener('click', (e) => {
      e.preventDefault();
      const open = sub.classList.toggle('is-open');
      tog.setAttribute('aria-expanded', String(open));
      closeSubs(sub);
    });

    // Leaving the whole group with the pointer drops the clicked open state
    // so it does not sit open behind the next hover.
    sub.addEventListener('mouseleave', () => {
      sub.classList.remove('is-open');
      tog?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (![...subs].some((s) => s.contains(t))) closeSubs();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = [...subs].find((s) => s.classList.contains('is-open'));
    closeSubs();
    (open?.querySelector('[data-sub-tog]') as HTMLElement | null)?.focus();
    // Also drop CSS focus-within by blurring anything inside a panel.
    const active = document.activeElement;
    if (active && [...subs].some((s) => s.querySelector('.sub')?.contains(active))) {
      (active as HTMLElement).blur();
    }
  });
</script>
