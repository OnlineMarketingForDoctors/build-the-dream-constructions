---
import { Image } from 'astro:assets';
import { services } from '../data/site.js';

const imgs = import.meta.glob('../assets/gen/mat-*.webp', { eager: true, import: 'default' });
const map = {
  'kitchen-renovations': imgs['../assets/gen/mat-kitchen.webp'],
  'bathroom-renovations': imgs['../assets/gen/mat-bathroom.webp'],
  decking: imgs['../assets/gen/mat-decking.webp'],
  flooring: imgs['../assets/gen/mat-flooring.webp'],
  tiling: imgs['../assets/gen/mat-tiling.webp'],
};
---

<section class="svc section" id="services" data-reveal>
  <div class="shell">
    <div class="setout">
      <span class="annot">02 / Services</span>
      <span class="setout-rule"></span>
    </div>
    <div class="svc-head">
      <h2 class="display display-l rise">The work<br />we do.</h2>
      <p class="lede rise rise-2">
        These trades overlap on most jobs, which is why running them under one
        contract works better than hiring each one separately.
      </p>
    </div>
  </div>

  <ul class="svc-grid rise rise-3">
    {services.map((s, i) => (
      <li class={`tile tile-${i + 1}`}>
        <a href={`/services/${s.slug}`} class="tile-a">
          <div class="tile-media">
            <Image
              src={map[s.slug]}
              alt={s.alt}
              widths={[420, 700, 1100]}
              sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 33vw"
              quality={76}
            />
          </div>
          <div class="tile-body">
            <span class="annot tile-mat">{s.material}</span>
            <h3 class="display display-m tile-name">{s.name}</h3>
            <p class="tile-lead">{s.lead}</p>
            <span class="tile-go">
              <span class="annot annot-signal">View service</span>
              <i class="btn-arrow"></i>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .svc-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .svc-head .lede {
    max-width: 44ch;
  }

  /* Tight joints, like a well set out tiled surface. */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap);
  }

  .tile-1 { grid-column: span 7; }
  .tile-2 { grid-column: span 5; }
  .tile-3,
  .tile-4,
  .tile-5 { grid-column: span 4; }

  .tile-a {
    position: relative;
    display: block;
    height: 100%;
    min-height: clamp(320px, 40vw, 520px);
    overflow: hidden;
    background: var(--surface);
    isolation: isolate;
  }

  .tile-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .tile-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.1s var(--ease);
    filter: brightness(0.86) saturate(0.9);
  }

  .tile-a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      var(--ink) 4%,
      color-mix(in srgb, var(--ink) 62%, transparent) 42%,
      color-mix(in srgb, var(--ink) 12%, transparent) 100%
    );
  }

  .tile-a:hover .tile-media :global(img),
  .tile-a:focus-visible .tile-media :global(img) {
    transform: scale(1.075);
  }

  .tile-body {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    display: grid;
    gap: 0.7rem;
    align-content: end;
  }

  .tile-mat {
    color: var(--bone-2);
  }

  .tile-name {
    font-size: clamp(1.4rem, 2.1vw, 2.15rem);
  }

  .tile-lead {
    color: var(--bone-2);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 40ch;
    /* Held back until hover on pointer devices, so the grid reads as image first. */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.6s var(--ease), opacity 0.4s var(--ease);
  }

  .tile-go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--signal);
    padding-top: 0.35rem;
    border-top: 1px solid var(--line-lift);
    width: fit-content;
  }

  @media (hover: hover) and (min-width: 861px) {
    .tile-a:hover .tile-lead,
    .tile-a:focus-visible .tile-lead {
      max-height: 8rem;
      opacity: 1;
    }
  }

  @media (hover: none), (max-width: 860px) {
    .tile-lead {
      max-height: none;
      opacity: 1;
    }
  }

  @media (max-width: 1100px) {
    .tile-1,
    .tile-2 { grid-column: span 12; }
    .tile-3,
    .tile-4,
    .tile-5 { grid-column: span 4; }
  }

  @media (max-width: 860px) {
    .svc-head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .tile-1,
    .tile-2,
    .tile-3,
    .tile-4,
    .tile-5 {
      grid-column: span 12;
    }
    .tile-a {
      min-height: 380px;
    }
  }
</style>
