---
import { Image } from 'astro:assets';
import heroImg from '../assets/projects/mdlm-living-kitchen.webp';
import { business } from '../data/site.js';

const facts = [
  { k: 'Established', v: String(business.founded) },
  { k: 'Team', v: `${business.team} people` },
  { k: 'Covering', v: 'Sydney wide' },
  { k: 'Licence', v: business.licence },
];
---

<section class="hero" id="top">
  <div class="hero-media">
    <Image
      src={heroImg}
      alt="Renovated open plan living and kitchen with a mitred stone island and timber flooring"
      widths={[900, 1400, 2000, 2800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
    <div class="hero-scrim"></div>
    <div class="hero-scrim-2"></div>
  </div>

  <div class="hero-in shell">
    <p class="annot hero-eyebrow">
      <span class="annot-signal">Sydney</span> · Renovations and additions
    </p>

    <h1 class="display display-xl hero-h">
      <span class="ln"><span>Building</span></span>
      <span class="ln"><span>your dream</span></span>
      <span class="ln"><span>home <em>starts</em></span></span>
      <span class="ln"><span>here</span></span>
    </h1>

    <div class="hero-tail">
      <p class="lede hero-lede">
        Kitchens, bathrooms, decking, flooring and tiling across Sydney. One
        contract, one team, and a fixed price agreed before we start.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/contact"><span>Request a quote</span><i class="btn-arrow"></i></a>
        <a class="btn btn-ghost" href="/projects"><span>See the work</span><i class="btn-arrow"></i></a>
      </div>
    </div>
  </div>

  <div class="hero-bar">
    <div class="shell hero-bar-in">
      {facts.map((f) => (
        <div class="fact">
          <span class="annot">{f.k}</span>
          <span class="fact-v">{f.v}</span>
        </div>
      ))}
      <a class="scroll-cue" href="#thesis" aria-label="Scroll to next section">
        <span class="annot">Scroll</span>
        <span class="cue-line"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 8rem;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
    animation: heroIn 2.4s var(--ease) both;
  }

  @keyframes heroIn {
    from {
      transform: scale(1.07);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Two scrims: one for the type on the left, one to seat the bottom bar. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    /* The dusk photograph is already dark, so the scrim only needs to hold
       the left side down enough for the headline rather than dim the whole
       frame. */
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--ink) 88%, transparent) 4%,
      color-mix(in srgb, var(--ink) 68%, transparent) 36%,
      color-mix(in srgb, var(--ink) 30%, transparent) 66%,
      color-mix(in srgb, var(--ink) 6%, transparent) 100%
    );
  }

  .hero-scrim-2 {
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--ink) 86%, transparent) 2%,
      transparent 100%
    );
  }

  .hero-in {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    width: 100%;
  }

  .hero-eyebrow {
    margin-bottom: clamp(1.25rem, 3vh, 2.25rem);
    opacity: 0;
    animation: fadeUp 0.9s var(--ease) 0.35s both;
  }

  .hero-h {
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
    max-width: 15ch;
  }

  .hero-h em {
    font-style: normal;
    color: var(--signal);
  }

  /* Each line is wiped up from behind a mask, like a line being set out. */
  .ln {
    display: block;
    overflow: hidden;
  }

  .ln > span {
    display: block;
    transform: translateY(102%);
    animation: lineUp 1.05s var(--ease-snap) both;
  }

  .ln:nth-child(1) > span { animation-delay: 0.42s; }
  .ln:nth-child(2) > span { animation-delay: 0.52s; }
  .ln:nth-child(3) > span { animation-delay: 0.62s; }
  .ln:nth-child(4) > span { animation-delay: 0.72s; }

  @keyframes lineUp {
    to { transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .hero-tail {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    opacity: 0;
    animation: fadeUp 1s var(--ease) 1.05s both;
  }

  .hero-lede {
    max-width: 46ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-bar {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    animation: fadeUp 1s var(--ease) 1.25s both;
  }

  .hero-bar-in {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    padding-block: 1.125rem;
  }

  .fact {
    display: grid;
    gap: 0.4rem;
  }

  .fact-v {
    font-family: var(--display);
    font-variation-settings: 'wdth' 104, 'wght' 700;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .scroll-cue {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cue-line {
    display: block;
    width: 46px;
    height: 1px;
    background: var(--line-lift);
    position: relative;
    overflow: hidden;
  }

  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform: translateX(-100%);
    animation: cue 2.6s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateX(-100%); }
    55% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 6.5rem;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 58%, transparent) 0%,
        color-mix(in srgb, var(--ink) 42%, transparent) 45%,
        var(--ink) 96%
      );
    }
    .fact:nth-child(n + 3),
    .scroll-cue {
      display: none;
    }
    .hero-bar-in {
      gap: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media :global(img),
    .hero-eyebrow,
    .hero-tail,
    .hero-bar {
      animation: none;
      opacity: 1;
    }
    .ln > span {
      transform: none;
      animation: none;
    }
    .cue-line::after {
      animation: none;
      transform: translateX(0);
    }
  }
</style>
