---
import { Image } from 'astro:assets';
import chalk from '../assets/gen/setout-chalkline-wide.webp';
---

<section class="thesis section" id="thesis" data-reveal>
  <div class="shell">
    <div class="setout">
      <span class="annot">01 / One contract</span>
      <span class="setout-rule"></span>
    </div>

    <div class="thesis-grid">
      <h2 class="display display-l rise">
        We manage<br />
        every trade<br />
        <em>on your job.</em>
      </h2>
      <div class="thesis-body rise rise-2">
        <p>
          A kitchen renovation needs a carpenter, a tiler, a floor layer, a
          plumber and an electrician. On most jobs the homeowner ends up
          booking them, chasing the ones who do not turn up, and sorting it out
          when one trade's work does not line up with another's.
        </p>
        <p>
          We handle all of that. You get one contract, one price and one number
          to call. We have been doing this since 2008 with our own team of
          twelve, and if something goes wrong it is ours to fix.
        </p>
      </div>
    </div>
  </div>

  <figure class="thesis-fig rise rise-3">
    <Image
      src={chalk}
      alt="A chalk line being snapped across a subfloor, leaving a straight yellow setout mark"
      widths={[1200, 2000, 2800]}
      sizes="100vw"
      quality={78}
    />
    <figcaption class="annot">
      <span class="annot-signal">Setout</span> · every job starts with a line on the floor
    </figcaption>
  </figure>
</section>

<style>
  .thesis {
    padding-bottom: 0;
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .thesis-grid h2 em {
    font-style: normal;
    color: var(--signal);
  }

  .thesis-body {
    display: grid;
    gap: 1.25rem;
    color: var(--bone-2);
    max-width: 54ch;
    padding-top: 0.5rem;
  }

  .thesis-fig {
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    position: relative;
  }

  .thesis-fig :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    height: auto;
    max-height: 76vh;
    object-fit: cover;
  }

  .thesis-fig figcaption {
    position: absolute;
    left: var(--pad-x);
    bottom: 1.5rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    backdrop-filter: blur(6px);
  }

  @media (max-width: 860px) {
    .thesis-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
